# Local development only. Replace these before using any shared environment.
POSTGRES_USER=ledgerflow
POSTGRES_PASSWORD=ledgerflow_local_only
POSTGRES_DB=ledgerflow
RABBITMQ_DEFAULT_USER=ledgerflow
RABBITMQ_DEFAULT_PASS=ledgerflow_local_only
DATABASE_URL=postgresql://ledgerflow:ledgerflow_local_only@localhost:5432/ledgerflow
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://ledgerflow:ledgerflow_local_only@localhost:5672
API_HOST=127.0.0.1
API_PORT=4000
# Server-only URL used by the Next.js status page.
API_URL=http://127.0.0.1:4000
# Browser-facing API origin; use the same hostname as the web app for session cookies.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Browser origin allowed to use credentialed API requests. Use localhost for both browser URLs.
WEB_ORIGIN=http://localhost:3000
NODE_ENV=development
